# Copy to frontend/.env.local (git-ignored) and fill in from the Firebase console:
# Project settings, General, Your apps, the web app's firebaseConfig.
# Only these four are needed (no Analytics, Storage or Messaging).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
