# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Port 5433 (not 5432) to avoid colliding with a locally-installed Postgres service, if any.
DATABASE_URL=postgresql+asyncpg://sales_intel:sales_intel@localhost:5433/sales_intel

# --- App ---
ENV=local
LOG_LEVEL=INFO
SECRET_KEY=changeme-generate-a-real-secret

# --- LLM (Phase 2c: Market Discovery text parsing; Phase 3 reuses the same client; Phase A1's
# Discovery Agent extraction stage defaults to this too) ---
# Free tier, no credit card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Discovery Agent (Phase A1) ---
# Which free-tier Gemini model powers the extraction stage specifically (company-name extraction
# from search results) — kept separate from GEMINI_MODEL so this one failure-sensitive stage can
# use a stronger free-tier model (e.g. a "pro" variant) than the rest of the app without changing
# every other Gemini call. Defaults to GEMINI_MODEL if unset.
DISCOVERY_AGENT_EXTRACTION_MODEL=

# --- Scraping (Phase 2a) ---
SCRAPER_USER_AGENT="SalesIntelligenceBot/0.1 (+internal tool)"
SCRAPER_REQUEST_DELAY_SECONDS=1.0

# Serper.dev — wraps real Google search results, used for domain discovery for companies with
# no domain on file (Phase 2a) and candidate-company discovery for Market Discovery (Phase 2c).
# Free tier, no card required: https://serper.dev. Leave blank to disable discovery (companies
# with no domain just fail enrichment with "no domain on file and none found"; Market Discovery
# runs will find 0 candidates instead of erroring).
SERPER_API_KEY=

# Google Custom Search JSON API — kept for reference/fallback only. Google deprecated
# "search the entire web" for newly created Custom Search Engines, so this can no longer power
# open-web discovery (only site-restricted search) and is not wired in as the default provider.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
