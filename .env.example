# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# The pgvector Postgres from infra/docker-compose.yml (service postgres-pgvector, host port 5435).
# See docs/database-runbook.md. With the least-privilege role, use sales_intel_app here and the
# owner (sales_intel) in MIGRATION_DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://sales_intel:sales_intel@localhost:5435/sales_intel
# Optional: Alembic connects here instead (hosted database: direct connection, schema owner role).
# MIGRATION_DATABASE_URL=
# Hosted database only: require, or verify-full with the provider's CA certificate.
# DB_SSL_MODE=disable
# DB_SSL_ROOT_CERT=
# Pool and server-side limits have safe defaults in backend/app/core/config.py (DB_POOL_SIZE,
# DB_STATEMENT_TIMEOUT_MS, DB_LOCK_TIMEOUT_MS, DB_WORKER_STATEMENT_TIMEOUT_MS, ...).

# --- App ---
ENV=local
LOG_LEVEL=INFO
SECRET_KEY=changeme-generate-a-real-secret

# --- LLM (Phase 2c: Market Discovery text parsing; Phase 3 reuses the same client; Phase A1's
# Discovery Agent extraction stage defaults to this too) ---
# Free tier, no credit card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Discovery Agent (Phase A1) ---
# Which free-tier Gemini model powers the extraction stage specifically (company-name extraction
# from search results) — kept separate from GEMINI_MODEL so this one failure-sensitive stage can
# use a stronger free-tier model (e.g. a "pro" variant) than the rest of the app without changing
# every other Gemini call. Defaults to GEMINI_MODEL if unset.
DISCOVERY_AGENT_EXTRACTION_MODEL=

# --- Scraping (Phase 2a) ---
SCRAPER_USER_AGENT="SalesIntelligenceBot/0.1 (+internal tool)"
SCRAPER_REQUEST_DELAY_SECONDS=1.0

# context.dev (evaluation, see docs/decisions/0012-context-dev-evaluation.md).
# Keep EXACTLY ONE of the two blocks active; restart the API and worker after changing it.
# [A] Our own scraper only - spends NO context.dev credits (key stays commented out).
COMPANY_DATA_SOURCE=scraper
# CONTEXT_DEV_API_KEY=
# [B] Scraper first, context.dev fills the gaps - spends credits.
# COMPANY_DATA_SOURCE=scraper_with_contextdev_fallback
# CONTEXT_DEV_API_KEY=your-key-here
CONTEXT_DEV_TIMEOUT_SECONDS=30
# Hard stop on context.dev spend per run (brand lookup ~10 credits, news ~1). Once reached, the
# run carries on with scraper data only.
CONTEXT_DEV_MAX_CREDITS_PER_RUN=150

# Serper.dev — wraps real Google search results, used for domain discovery for companies with
# no domain on file (Phase 2a) and candidate-company discovery for Market Discovery (Phase 2c).
# Free tier, no card required: https://serper.dev. Leave blank to disable discovery (companies
# with no domain just fail enrichment with "no domain on file and none found"; Market Discovery
# runs will find 0 candidates instead of erroring).
SERPER_API_KEY=

# Google Custom Search JSON API — kept for reference/fallback only. Google deprecated
# "search the entire web" for newly created Custom Search Engines, so this can no longer power
# open-web discovery (only site-restricted search) and is not wired in as the default provider.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- Documents (Phase 8, released in 8f) ---
# Decks, PDFs, Word and Markdown files about what we sell, read into a knowledge base the AI flows
# use. On by default; set false to hide it (the Documents page then says it is off). Restart the API
# and the worker after changing any of these. Meaning search and summaries need GEMINI_API_KEY; with
# no key they switch themselves off and search works by words only.
DOCUMENTS_ENABLED=true
# The upload is held only until the worker has read it (a failed one for this many hours).
# DOCUMENTS_STAGING_RETENTION_HOURS=24
# Largest file accepted, in MB. The Documents page reads this from the API, so it follows.
DOCUMENTS_MAX_UPLOAD_MB=5
# DOCUMENTS_MAX_PAGES=300
# Describe pictures, charts and scanned pages with Gemini. Spends Gemini quota, so off by default;
# a document with no pictures never needs it. Needs GEMINI_API_KEY.
DOCUMENTS_VISION_ENABLED=false
# DOCUMENTS_VISION_MAX_IMAGES=40
# Index passages by meaning (Gemini embeddings) so search finds "reduce development cost" in a
# passage about "cutting build spend". Spends Gemini quota (small: about 0.15 USD per million tokens
# when paid). Off: search still works, by words only. Needs GEMINI_API_KEY.
DOCUMENTS_EMBEDDINGS_ENABLED=true
# DOCUMENTS_EMBEDDING_MODEL=gemini-embedding-001
# DOCUMENTS_MIN_SIMILARITY=0.0
# Passages from the documents given to the prompts that reason about our offerings: offering fit,
# recommendation, area suggestions and the Quick Check summary (0 turns it off). Prompts that carry
# them go to Gemini only; with no Gemini answer they are asked again without the passages.
# DOCUMENTS_KNOWLEDGE_PASSAGES=5
# Phase 8e: after a document is read, Gemini (only) writes a summary and draws knowledge cards from
# it: short facts, each checked against the words of the passage it came from. A few Gemini calls per
# document. Long files are summarised in sections, up to a cap; the rest stays searchable.
DOCUMENTS_CARDS_ENABLED=true
# DOCUMENTS_CARDS_SECTION_CHARS=6000
# DOCUMENTS_CARDS_MAX_SECTIONS=15
# DOCUMENTS_CARDS_MAX_PER_SECTION=8
# DOCUMENTS_CARDS_MAX_PER_DOCUMENT=60
# How many cards the flows see ahead of the passages (0: cards are kept but not used in prompts).
# DOCUMENTS_KNOWLEDGE_CARDS=4
# A document tied to offerings may suggest a better description for them, as a proposal waiting for
# review under Offerings. Never applied on its own; approving changes the description only.
# DOCUMENTS_OFFERING_PROPOSALS_ENABLED=true
